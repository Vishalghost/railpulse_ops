# Copied into both EB source bundles (worker + web) by infra/railpulse_infra/eb_common.py.
#
# Our apps run in Docker containers on a bridge network: one network hop behind the host.
# IMDSv2 token responses are dropped after `HttpPutResponseHopLimit` hops, so with a limit
# of 1 boto3 inside the container can't get instance-role credentials. AL2023 AMIs default
# to 2, but rather than rely on whatever the AMI / EB launch template ends up with, each
# instance sets it explicitly at boot (idempotent; runs on every deploy before containers start).
# The instance role may only modify instances in its own environment (see eb_common.py).
commands:
  01_imds_hop_limit:
    command: |
      set -euo pipefail
      TOKEN=$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
      MD="curl -sf -H X-aws-ec2-metadata-token:$TOKEN http://169.254.169.254/latest/meta-data"
      ID=$($MD/instance-id)
      REGION=$($MD/placement/region)
      aws ec2 modify-instance-metadata-options --region "$REGION" --instance-id "$ID" \
        --http-endpoint enabled --http-tokens required --http-put-response-hop-limit 2
